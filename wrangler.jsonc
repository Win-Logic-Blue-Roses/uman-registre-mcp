{
  // MCP du registre U-MAN Art. Ne jamais changer « name » (le compte Cloudflare héberge d'autres sites).
  "name": "uman-registre-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-10-25",
  // Domaine personnalisé (DNS) + route précise : sans elle, la route « *.u-man.art/* » du Worker u-man (anciennes
  // adresses d'artistes, 301) passe avant le domaine personnalisé. La route la plus précise l'emporte.
  "routes": [
    { "pattern": "mcp.u-man.art", "custom_domain": true },
    { "pattern": "mcp.u-man.art/*", "zone_name": "u-man.art" }
  ],
  "workers_dev": false,
  // Valeurs publiques : adresse du projet Supabase et clé « publishable » (faite pour être publique ; la sécurité
  // repose sur les règles de la base et sur le jeton de l'artiste).
  "vars": {
    "SUPABASE_URL": "https://lznftgdbsqecucjpcbjm.supabase.co",
    "SUPABASE_CLE_PUBLIQUE": "sb_publishable_Rjx3EHNb1Csf0_HOKb6RoQ_IG9oJo8c"
  },
  // 60 appels par minute et par compte. namespace_id : entier propre au compte Cloudflare.
  "ratelimits": [{ "name": "LIMITE", "namespace_id": "4202", "simple": { "limit": 60, "period": 60 } }],
  "observability": { "enabled": true }
}
